FROM nvidia/cuda:12.3.2-cudnn9-devel-ubuntu22.04
 
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

# OpenCV needs to be compiled against this image's CUDA toolkit; the Ubuntu
# and PyPI OpenCV packages are CPU-only. Override for deployment GPUs, e.g.
# --build-arg OPENCV_CUDA_ARCH_BIN="8.6;8.9".
ARG OPENCV_VERSION=4.10.0
ARG OPENCV_CUDA_ARCH_BIN="7.5;8.0;8.6;8.9;9.0"
 
# ---------------------------------------------------------------------------
# 1. System dependencies
#    Added libgomp1      → required by PaddlePaddle GPU runtime (OpenMP)
#    Added libstdc++6    → required by Paddle's bundled native libs
#    Added python3-venv  → good practice; avoids pip --break-system-packages
#    Everything else unchanged from original
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    build-essential cmake git wget curl unzip \
    python3 python3-pip python3-dev python3-venv \
    pkg-config libjpeg-dev libpng-dev libtiff-dev \
    libavcodec-dev libavformat-dev libswscale-dev libv4l-dev \
    libxvidcore-dev libx264-dev libgtk-3-dev \
    libopenblas-dev gfortran \
    tesseract-ocr tesseract-ocr-deu \
    libtesseract-dev \
    qt6-base-dev qt6-tools-dev \
    libgl1 libglib2.0-0 \
    libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
 
# ---------------------------------------------------------------------------
# 2. OpenCV with CUDA. Build OpenCV and opencv_contrib from the same pinned
#    release. CUDA_ARCH_BIN can be overridden to reduce build time and size.
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir "numpy<2" && \
    git clone --depth 1 --branch "${OPENCV_VERSION}" \
        https://github.com/opencv/opencv.git /tmp/opencv && \
    git clone --depth 1 --branch "${OPENCV_VERSION}" \
        https://github.com/opencv/opencv_contrib.git /tmp/opencv_contrib && \
    mkdir /tmp/opencv/build && cd /tmp/opencv/build && \
    cmake \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_INSTALL_PREFIX=/usr/local \
        -D OPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules \
        -D WITH_CUDA=ON \
        -D WITH_CUDNN=ON \
        -D OPENCV_DNN_CUDA=ON \
        -D CUDA_ARCH_BIN="${OPENCV_CUDA_ARCH_BIN}" \
        -D BUILD_opencv_python3=ON \
        -D PYTHON3_EXECUTABLE=/usr/bin/python3 \
        -D PYTHON3_INCLUDE_DIR=/usr/include/python3.10 \
        -D PYTHON3_NUMPY_INCLUDE_DIRS=/usr/local/lib/python3.10/dist-packages/numpy/core/include \
        -D BUILD_TESTS=OFF \
        -D BUILD_PERF_TESTS=OFF \
        -D BUILD_EXAMPLES=OFF \
        -D BUILD_opencv_apps=OFF \
        .. && \
    cmake --build . --parallel "$(nproc)" && \
    cmake --install . && \
    ldconfig && \
#    python3 -c 'import re, cv2; info = cv2.getBuildInformation(); assert re.search(r"(?m)^\s*NVIDIA CUDA:\s+YES\b", info), "OpenCV was built without CUDA"; print("OpenCV CUDA build confirmed")' && \
    rm -rf /tmp/opencv /tmp/opencv_contrib

# ---------------------------------------------------------------------------
# 3. Python AI stack — PaddlePaddle 3.x (replaces old 2.x paddlepaddle-gpu)
#
#    WHY cu118 wheel on CUDA 12.3?
#    Paddle does not publish a cu123-specific wheel. The cu118 build links
#    against CUDA runtime libs that ship inside the wheel itself (via
#    bundled .so files), so it runs correctly on any CUDA 12.x host driver.
#    This is the officially recommended approach for CUDA 12.x users.
#
#    WHY paddleocr[doc-parser]?
#    The [doc-parser] extra pulls in PP-StructureV3 dependencies (layout
#    analysis, table recognition) needed for distinguishing printed vs
#    handwritten regions — core to this project's region classifier.
#
#    WHY a separate index URL (-i flag)?
#    PaddlePaddle GPU wheels are not on PyPI. They are hosted on Paddle's
#    own package server. The -i flag points pip to that server for the
#    paddlepaddle-gpu install only; all other packages still come from PyPI.
# ---------------------------------------------------------------------------
RUN pip3 install --upgrade pip && \
    pip3 install \
        paddlepaddle-gpu==3.0.0 \
        -i https://www.paddlepaddle.org.cn/packages/stable/cu118/ && \
    pip3 install \
        "paddleocr[doc-parser]" \
        pillow && \
    pip3 uninstall -y \
        opencv-python opencv-python-headless \
        opencv-contrib-python opencv-contrib-python-headless
 
# ---------------------------------------------------------------------------
# 4. Workspace
#    /workspace is bind-mounted to $HOME on the host at container run-time
#    (see run_exam_extractor.sh). We set it as WORKDIR so any docker exec
#    session drops straight into the project root.
#
#    NOTE — model caching:
#    PaddleOCR downloads models to ~/.paddleocr/ on first use. Because
#    $HOME on the host is mounted to /workspace, the cache lands on the
#    host filesystem and persists across container restarts and recreation.
#    Run scripts/download_models.py once after first container start to
#    pre-populate the cache while you still have internet access.
# ---------------------------------------------------------------------------
WORKDIR /workspace
